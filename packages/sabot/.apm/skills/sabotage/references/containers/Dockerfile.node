# Node/web surface. Base + node, jazzer, fast-check, retire.
#
# retire.js reads its vulnerability definitions from a `jsrepository-v5.json` it
# fetches from raw.githubusercontent.com on every run. Under --network none that
# fetch fails and retire finds nothing -- a false-clean. So the definition file is
# baked at build time and the web.md recipe runs `retire --jsrepo <baked path>`,
# which reads the local copy and skips the fetch (retire 5.x has no --noupdate flag;
# --jsrepo <local file> is the offline mechanism).
ARG BASE=sabot/base:1
FROM node:22-slim
USER root
RUN apt-get update -q && apt-get install -y --no-install-recommends ripgrep git ca-certificates >/dev/null \
 && npm i -g @jazzer.js/core fast-check retire 2>&1 | tail -1 || true

# retire.js vulnerability definitions, baked. Pinned by commit SHA of the RetireJS
# repo (tag-less rolling data), advanced by hand; renovate's semver datasource cannot
# track a bare SHA. Fetch only the pinned commit, keep the JSON, drop the rest.
ARG RETIREJS_SHA=680dfa2e2a436c9b66ab758693629a3cb92196ac
RUN mkdir -p /tmp/retirejs && cd /tmp/retirejs && git init -q \
 && git remote add origin https://github.com/RetireJS/retire.js \
 && git fetch -q --depth 1 origin "$RETIREJS_SHA" \
 && git checkout -q FETCH_HEAD \
 && mkdir -p /opt/sabot-db/retire \
 && cp repository/jsrepository-v5.json /opt/sabot-db/retire/ \
 && rm -rf /tmp/retirejs

RUN useradd --create-home --uid 1000 breaker && mkdir -p /artifacts /scratch && chown breaker /artifacts /scratch /opt/sabot-db/retire
USER breaker
WORKDIR /scratch
VOLUME /artifacts
