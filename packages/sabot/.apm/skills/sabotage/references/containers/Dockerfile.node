# Node/web surface. Base + node, jazzer, fast-check, retire.
#
# retire.js reads its vulnerability definitions from a `jsrepository-v5.json` it
# fetches from raw.githubusercontent.com on every run. Under --network none that
# fetch fails and retire finds nothing -- a false-clean. So the definition file is
# baked at build time and the web.md recipe runs `retire --jsrepo <baked path>`,
# which reads the local copy and skips the fetch (retire 5.x has no --noupdate flag;
# --jsrepo <local file> is the offline mechanism).
#
# The tag is trixie-slim, not the default slim (bookworm), because Jazzer.js ships a
# PREBUILT arm64 native addon linked against GLIBC_2.38. Bookworm carries 2.36, so
# `jazzer` died at dlopen with ERR_DLOPEN_FAILED while `npm i -g` had reported
# success -- the fuzzer was installed and unrunnable. Trixie carries 2.41 (bs-156).
ARG BASE=sabot/base:1
FROM node:22-trixie-slim
USER root
# Not masked by `|| true`: a failed install must fail the build, because a missing
# fuzzer reported as present returns a clean the campaign did not earn. The build
# then RUNS each tool, since installing a native addon and loading it are different
# questions -- the one this image got wrong.
RUN apt-get update -q && apt-get install -y --no-install-recommends ripgrep git ca-certificates >/dev/null \
 && rm -rf /var/lib/apt/lists/* \
 && npm i -g fast-check retire >/dev/null \
 && retire --version \
 && NODE_PATH=/usr/local/lib/node_modules node -e 'require("fast-check")'

# Jazzer.js is installed LOCALLY into a prefix dir, not with `npm i -g`, and that is the
# whole fix for a fuzzer that reported itself present and could not fuzz.
#
# `npm i -g @jazzer.js/core` nests the @jazzer.js peers (bug-detectors, fuzzer, hooking,
# instrumentor) under core/node_modules/, while core resolves them as SIBLINGS. Measured,
# `jazzer --version` answered and every real run died before the first input:
#
#   Error: ENOENT: no such file or directory, scandir
#   '/usr/local/lib/node_modules/@jazzer.js/bug-detectors/dist/internal'
#
# That is the exact false-clean class this image already got wrong once with the arm64
# dlopen (bs-156): installed, asserted, unrunnable. A local install produces the flat
# sibling layout core expects.
#
# So the build ALSO runs a real fuzz target and requires a crash, not a version string.
# The target dereferences parts[1] with no colon in the input, so libFuzzer must report an
# uncaught TypeError and write a crash artifact; anything less means the addon loaded but
# the instrumentation did not.
RUN mkdir -p /opt/jazzer && cd /opt/jazzer \
 && npm init -y >/dev/null \
 && npm i @jazzer.js/core >/dev/null \
 && ln -sf /opt/jazzer/node_modules/.bin/jazzer /usr/local/bin/jazzer \
 && test -d /opt/jazzer/node_modules/@jazzer.js/bug-detectors/dist/internal \
 && jazzer --version \
 && mkdir -p /tmp/jzprobe && cd /tmp/jzprobe \
 && printf 'module.exports.fuzz = function (d) { return d.toString().split(":")[1].trim(); };\n' > fuzz.js \
 && (jazzer fuzz.js -- -runs=50000 -max_total_time=120 > out.txt 2>&1 || true) \
 && grep -q 'Uncaught Exception' out.txt \
 && echo "jazzer.js fuzzes and reports a crash (not just --version)" \
 && cd / && rm -rf /tmp/jzprobe

# fast-check is a LIBRARY with no CLI, so it is reachable only via NODE_PATH; a
# harness that does `require("fast-check")` fails without this. Set for every run
# rather than in each recipe.
ENV NODE_PATH=/usr/local/lib/node_modules

# retire.js vulnerability definitions, baked. Pinned by commit SHA of the RetireJS
# repo (tag-less rolling data), advanced by hand; renovate's semver datasource cannot
# track a bare SHA. Fetch only the pinned commit, keep the JSON, drop the rest.
ARG RETIREJS_SHA=680dfa2e2a436c9b66ab758693629a3cb92196ac
RUN mkdir -p /tmp/retirejs && cd /tmp/retirejs && git init -q \
 && git remote add origin https://github.com/RetireJS/retire.js \
 && git fetch -q --depth 1 origin "$RETIREJS_SHA" \
 && git checkout -q FETCH_HEAD \
 && mkdir -p /opt/sabot-db/retire \
 && cp repository/jsrepository-v5.json /opt/sabot-db/retire/ \
 && rm -rf /tmp/retirejs

# node:22-slim already ships a uid-1000 user ("node"), so reuse it rather than create
# a colliding "breaker" (useradd --uid 1000 fails "UID not unique"). run-contained.sh
# runs --user 1000:1000, so this uid owns the writable mounts either way.
RUN mkdir -p /artifacts /scratch && chown 1000:1000 /artifacts /scratch /opt/sabot-db/retire
USER 1000:1000
WORKDIR /scratch
VOLUME /artifacts
