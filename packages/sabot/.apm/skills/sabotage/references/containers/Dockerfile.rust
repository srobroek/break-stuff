# Rust surface. Base + the rust toolchain and code/robustness tools.
#
# Composes per the base model: FROM the language-free base, then run the rust
# fragment (layers/rust.sh) which installs rustup + a pinned stable + a pinned
# nightly (cargo-fuzz's libFuzzer needs nightly -Zsanitizer) + cargo-fuzz +
# cargo-audit. Pins and their renovate comments live in the fragment.
#
# Build: docker build -f Dockerfile.rust -t sabot/rust:1 --build-arg BASE=sabot/base:1 .
ARG BASE=sabot/base:1
FROM ${BASE}
USER root
COPY layers/rust.sh /tmp/rust.sh
RUN bash /tmp/rust.sh && rm /tmp/rust.sh
# rustup lives under /usr/local/cargo; put it on PATH for every user and run.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
USER breaker
WORKDIR /scratch
VOLUME /artifacts
